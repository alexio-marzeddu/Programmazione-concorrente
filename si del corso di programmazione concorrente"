[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // Codice comune a processo padre e figlio[m
[32m+[m[32m  printf("[FINE] - Termine del processo con pid=%d, ris=%d, padre=%d\n", getpid(), ris, getppid());[m
[32m+[m[32m}[m
[32m+[m[32m//------------------------------------------------------------------------------------------[m
[32m+[m[32m//=== Local Functions ======================================================================[m
[32m+[m[32m//------------------------------------------------------------------------------------------[m
[32m+[m[32mvoid childProcess(void)[m
[32m+[m[32m{[m
[32m+[m[32m  // op1 e op2 inizializzate con il valore assegnato dal padre prima della fork()[m
[32m+[m[32m  // ris ha valore diverso rispetto al processo padre[m
[32m+[m[32m  ris=op1+op2;[m[41m [m
[32m+[m[32m  printf("\n[Figlio] - Il risultato della somma di op1+op2=%d\n", ris);[m
[32m+[m[32m  printf("[Figlio] - pid=%d, pid padre=%d\n", getpid(), getppid());[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mvoid fatherProcess(int childpid)[m
[32m+[m[32m{[m
[32m+[m[32m  ris=op1*op2;[m
