[32m+[m
[32m+[m[32m  // Creazione del processo figlio[m
[32m+[m[32m  int pid=fork();[m
[32m+[m[32m  if (pid==0) {[m
[32m+[m[32m    // Esecuzione codice del processo figlio[m
[32m+[m[32m    childProcess();[m
[32m+[m[32m  } else if (pid>0) {[m
[32m+[m[32m    // Esecuzione codice del processo padre[m
[32m+[m[32m    fatherProcess(pid);[m
[32m+[m[32m  } else { // pid<0[m
[32m+[m[32m    // Errore[m
